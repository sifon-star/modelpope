<style>
:root{--k:#000;--w:#fff;--g:#8a8a8a;--d:#1a1a1a;--serif:"Bodoni Moda","Didot",Georgia,serif;--sans:"Jost","Helvetica Neue",Arial,sans-serif;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*,*::before,*::after{box-sizing:inherit}
html{scroll-behavior:smooth;scroll-padding-top:70px;background:var(--k)}
body{margin:0;background:var(--k);color:var(--w);font-family:var(--sans);font-weight:300;font-size:17px;line-height:1.6;overflow-x:hidden}
a{color:inherit;text-decoration:none}
