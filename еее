/* hero */
.hero{position:relative;min-height:100svh;display:flex;flex-direction:column;justify-content:flex-end;padding-bottom:clamp(28px,5vw,56px);overflow:hidden}
.mirror{position:absolute;right:-8vw;top:6vh;width:min(62vw,720px);aspect-ratio:3/4;pointer-events:none}
.mirror i{position:absolute;inset:0;border:1px solid rgba(255,255,255,.5);border-radius:50%;animation:spin 24s linear infinite}
.mirror i:nth-child(2){inset:8%;animation-duration:32s;animation-direction:reverse;border-color:rgba(255,255,255,.28)}
.mirror i:nth-child(3){inset:17%;animation-duration:40s;border-color:rgba(255,255,255,.16)}
.mirror b{position:absolute;inset:26%;border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff 0,#bdbdbd 18%,#3a3a3a 55%,#000 78%);animation:breathe 7s ease-in-out infinite}
@keyframes spin{to{transform:rotate(360deg) scaleX(.82)}}
@keyframes breathe{50%{transform:scale(1.07) translateY(-2%)}}
.hero h1{margin:0;font-family:var(--serif);font-weight:400;font-size:clamp(50px,16.5vw,260px);line-height:.88;letter-spacing:-.03em;display:flex;position:relative}
.hero h1 span{display:block;overflow:hidden;padding-bottom:.06em}
