.row::before{content:"";position:absolute;inset:0;background:#fff;transform:scaleY(0);transform-origin:bottom;transition:transform .55s cubic-bezier(.7,0,.2,1)}
.row button{all:unset;box-sizing:border-box;position:relative;display:grid;grid-template-columns:1fr auto auto;align-items:center;gap:clamp(12px,3vw,48px);width:100%;padding:clamp(20px,3vw,34px) clamp(8px,1vw,16px);cursor:pointer;transition:color .4s}
