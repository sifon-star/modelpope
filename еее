.logo{font-family:var(--serif);font-size:24px;letter-spacing:.02em}
nav ul{display:flex;gap:32px;list-style:none;margin:0;padding:0;font-size:15px}
nav ul a{position:relative}
nav ul a::after{content:"";position:absolute;left:0;bottom:-3px;height:1px;width:100%;background:currentColor;transform:scaleX(0);transform-origin:right;transition:transform .4s cubic-bezier(.7,0,.2,1)}
nav ul a:hover::after{transform:scaleX(1);transform-origin:left}
