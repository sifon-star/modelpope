<script>
(function(){
  var rm=matchMedia("(prefers-reduced-motion:reduce)").matches;

  // cursor
  var cur=document.querySelector(".cur"),cx=-100,cy=-100,tx=-100,ty=-100,sc=.25,ts=.25;
  addEventListener("pointermove",function(e){tx=e.clientX;ty=e.clientY;ts=1});
  document.addEventListener("pointerover",function(e){cur.classList.toggle("big",!!e.target.closest("a,button,.w,select,input"))});
  document.addEventListener("mouseleave",function(){ts=.25});

  // marquee
  var mq=document.getElementById("mq"),words=["Волосы","Ногти","Лицо","Брови","Макияж"],dot='<svg viewBox="0 0 10 10"><circle cx="5" cy="5" r="5" fill="currentColor"/></svg>',h="";
  for(var r=0;r<4;r++)for(var i=0;i<words.length;i++)h+="<span>"+words[i]+"</span>"+dot;
  mq.innerHTML=h;var mqx=0,mqv=.6,last=0;

  // statement words
  var st=document.getElementById("st"),parts=st.textContent.split(" ");
  st.innerHTML=parts.map(function(w){return "<span>"+w+"</span>"}).join(" ");
  var sw=st.querySelectorAll("span");

  // accordion
  document.querySelectorAll(".row button").forEach(function(b){
    b.addEventListener("click",function(){
      var row=b.parentNode,open=!row.classList.contains("open");
      document.querySelectorAll(".row.open").forEach(function(o){o.classList.remove("open");o.querySelector("button").setAttribute("aria-expanded","false")});
      if(open){row.classList.add("open");b.setAttribute("aria-expanded","true")}
    });
  });

  // counters
  var cio=new IntersectionObserver(function(es){es.forEach(function(e){
    if(!e.isIntersecting)return;cio.unobserve(e.target);
    var el=e.target,n=+el.dataset.n,t0=performance.now(),d=rm?1:1800;
    (function step(t){var p=Math.min(1,(t-t0)/d),v=1-Math.pow(1-p,4);el.textContent=Math.round(n*v).toLocaleString("ru-RU");if(p<1)requestAnimationFrame(step)})(t0);
  })},{threshold:.6});
  document.querySelectorAll("[data-n]").forEach(function(el){cio.observe(el)});

  // form
  document.getElementById("f").addEventListener("submit",function(e){
    e.preventDefault();
    var n=this.n.value.trim().split(" ")[0];
    document.getElementById("done").textContent=n+", заявка отправлена. Мы позвоним вам в течение часа.";
    document.getElementById("bk").classList.add("sent");
  });

  // frame loop
  var arts=document.querySelectorAll(".art"),lastY=scrollY,vel=0;
  function loop(t){
    cx+=(tx-cx)*.16;cy+=(ty-cy)*.16;sc+=(ts-sc)*.12;
    cur.style.transform="translate3d("+cx+"px,"+cy+"px,0) scale("+sc+")";
    var y=scrollY;vel+=((y-lastY)-vel)*.15;lastY=y;
    if(!rm){
      mqx-=mqv+Math.abs(vel)*.35;
      var w=mq.scrollWidth/4;if(-mqx>w)mqx+=w;
      mq.style.transform="translateX("+mqx+"px)";
      var vh=innerHeight;
      arts.forEach(function(a){
        var r=a.parentNode.getBoundingClientRect();
        if(r.bottom<0||r.top>vh)return;
        var p=(r.top+r.height/2-vh/2)/vh;
        a.style.transform="translate3d(0,"+(-p*r.height*(+a.dataset.s)*2.2)+"px,0)";
      });
    }
    var sr=st.getBoundingClientRect(),prog=(innerHeight*.85-sr.top)/(sr.height+innerHeight*.3);
    sw.forEach(function(s,i){s.style.opacity=(prog*1.15>i/sw.length)?1:.14});
    requestAnimationFrame(loop);
  }
  requestAnimationFrame(loop);
})();
</script>
